<script>
  // ------- Personnalise ici -------
  const PRENOM = "Alma"; // remplace par son prénom si besoin
  const messages = [
    `Ta persévérance. Peu importe combien la journée a été dure, tu te relèves à chaque fois, sans jamais vraiment baisser les bras. Cette force-là, je ne la vois pas souvent chez les gens, et elle m'impressionne beaucoup plus que tu ne le crois.`,
    `Ta gentillesse. Tu prends soin des gens autour de toi, même quand ils ne le méritent pas toujours, sans jamais rien attendre en retour. C'est rare, et c'est une des choses qui me touche le plus chez toi.`,
    `Ta lucidité. Tu vois les choses telles qu'elles sont, sans te mentir à toi-même ni aux autres, même quand c'est inconfortable. Cette maturité-là, je l'admire à chaque fois qu'on se parle vraiment.`,
    `Ton intelligence. La façon dont tu réfléchis, dont tu analyses une situation sous plusieurs angles avant de conclure... j'apprends des choses rien qu'en t'écoutant, et tu me pousses à réfléchir plus loin, à être meilleur.`,
    `Ta beauté. Oui, celle qu'on voit, mais surtout celle qui ressort quand tu souris pour de vrai, quand tu es toi-même sans artifice. C'est cette beauté-là qui me fait craquer à chaque fois, pas l'autre.`
  ];

  // ------- Écran d'accueil : "coucou Alma, ça va ?" -------
  const gate = document.getElementById('gate');
  const gateAnswer = document.getElementById('gate-answer');
  const gateButtons = document.getElementById('gate-buttons');
  const continueBtn = document.getElementById('continue-btn');
  const site = document.getElementById('site');
  const presentation = document.getElementById('presentation');
  const yesBtn = document.getElementById('yes-btn');
  const noBtn = document.getElementById('no-btn');
  const envelope = document.getElementById('envelope');
  const letterOverlay = document.getElementById('letter-overlay');
  const letterPaper = document.getElementById('letter-paper');
  const poemText = document.getElementById('poem-text');
  const closeLetterBtn = document.getElementById('close-letter');
  const musicPlayer = document.getElementById('music-player');
  const musicHideBtn = document.getElementById('music-hide');
  const musicShowBtn = document.getElementById('music-show');

  musicHideBtn.addEventListener('click', () => {
    musicPlayer.classList.add('hidden');
    musicHideBtn.style.display = 'none';
    musicShowBtn.style.display = 'flex';
  });

  musicShowBtn.addEventListener('click', () => {
    musicPlayer.classList.remove('hidden');
    musicShowBtn.style.display = 'none';
    musicHideBtn.style.display = 'flex';
  });
  const letterCloseX = document.getElementById('letter-close');
  const gossip = document.getElementById('gossip');
  const gossipContinueBtn = document.getElementById('gossip-continue');

  const poem = `Alma,

Mon amour, ces derniers jours ont été durs, beaucoup d'embrouilles et beaucoup d'incompréhension. Mais aucun de nous deux n'a mérité tout ça, et même si on s'est excusés, pour moi ce n'est pas assez après tout ce qu'on s'est infligé. Ça fait presque un an de relation, et des embrouilles enfantines méritent plus que de simples pardons ou "désolés".

C'est pourquoi j'ai fait ce site, pour te rappeler à quel point je t'aime et je tiens à toi.

Je vais aussi essayer de te faire voyager à travers des photos de nous et nos conversations, mais avant tout ça, Alma, j'aimerais te dire combien je t'aime. J'aimerais faire plus, c'est vrai que la distance c'est dur, mais on y arrivera, promis, et je crois en nous.

Franchement il est 10h38 à l'heure où je t'écris et je fais ce site sur un coup de tête, alors j'ai pas trop les mots, mais on est làààà mon gars Almouuu.`;
  poemText.textContent = poem;

  function spawnDeco(container, chars, count){
    for(let i = 0; i < count; i++){
      const d = document.createElement('div');
      d.className = 'deco-icon';
      d.textContent = chars[Math.floor(Math.random() * chars.length)];
      d.style.left = Math.random() * 100 + 'vw';
      d.style.animationDuration = (8 + Math.random() * 10) + 's';
      d.style.animationDelay = (Math.random() * 8) + 's';
      d.style.fontSize = (1 + Math.random() * 0.8) + 'rem';
      document.body.appendChild(d);
    }
  }

  function showPresentation(){
    gate.classList.add('hidden');
    presentation.classList.add('visible');
    spawnDeco(presentation, ['🐱','🐈','💗','🤍','✨','🐾','💕'], 16);
  }

  function showGossip(){
    presentation.classList.remove('visible');
    document.body.classList.add('gossip-active');
    gossip.classList.add('visible');
  }

  function enterSite(){
    presentation.classList.remove('visible');
    gossip.classList.remove('visible');
    document.body.classList.remove('gossip-active');
    site.classList.add('visible');
  }

  yesBtn.addEventListener('click', () => {
    gateButtons.style.display = 'none';
    gateAnswer.textContent = "D'accord bb, j'ai fait ce site pour toi, j'espère que ça te plaira.";
    continueBtn.style.display = 'inline-block';
  });

  noBtn.addEventListener('click', () => {
    gateButtons.style.display = 'none';
    gateAnswer.textContent = "Ne t'inquiète pas, j'espère que ce site te redonnera ton plus beau sourire.";
    continueBtn.style.display = 'inline-block';
  });

  continueBtn.addEventListener('click', () => {
    showPresentation();
  });

  envelope.addEventListener('click', () => {
    if(envelope.classList.contains('open')) return;
    envelope.classList.add('open');
    setTimeout(() => {
      letterOverlay.classList.add('active');
      letterPaper.classList.add('active');
    }, 550);
  });

  closeLetterBtn.addEventListener('click', () => {
    letterOverlay.classList.remove('active');
    letterPaper.classList.remove('active');
    showGossip();
  });

  gossipContinueBtn.addEventListener('click', () => {
    enterSite();
  });

  letterCloseX.addEventListener('click', () => {
    letterOverlay.classList.remove('active');
    letterPaper.classList.remove('active');
    envelope.classList.remove('open');
  });

  letterOverlay.addEventListener('click', () => {
    letterOverlay.classList.remove('active');
    letterPaper.classList.remove('active');
    envelope.classList.remove('open');
  });

  const card = document.getElementById('card');
  const messageEl = document.getElementById('message');
  const counterEl = document.getElementById('counter');
  const gardenEl = document.getElementById('garden');
  const btn = document.getElementById('reveal');
  const dots = document.querySelectorAll('#progress-dots .dot');
  const reasonsView = document.getElementById('reasons-view');
  const finaleView = document.getElementById('finale-view');
  const finalePoemEl = document.getElementById('finale-poem');

  const finalPoem = `Alma,

voilà, tu as tout vu :
le clic, la lettre, les rires figés en photos,
et ces cinq petites raisons
qui n'en résument même pas mille autres.

On n'a pas toujours les mots justes,
on s'embrouille, on recommence,
mais je choisis, encore et encore,
de rester, et d'apprendre à mieux t'aimer.

Merci d'être arrivée jusqu'ici,
merci d'être exactement qui tu es.

Je t'aime, Alma,
aujourd'hui, et pour longtemps encore.`;
  finalePoemEl.textContent = finalPoem;

  let count = 0;
  const hearts = ['💗','💛','🤍','💫','🌸','✨','💕'];

  function showFinale(){
    reasonsView.classList.add('fade-out');
    setTimeout(() => {
      finaleView.classList.add('visible');
    }, 400);
  }

  btn.addEventListener('click', () => {
    if(count < messages.length){
      const next = messages[count];
      count++;

      card.classList.add('flip');
      setTimeout(() => {
        messageEl.classList.remove('placeholder');
        messageEl.textContent = next;
        counterEl.textContent = 'Raison n° ' + count + ' / ' + messages.length;
        card.classList.remove('flip');
      }, 260);

      const heart = document.createElement('span');
      heart.textContent = hearts[Math.floor(Math.random() * hearts.length)];
      gardenEl.appendChild(heart);

      if(dots[count - 1]) dots[count - 1].classList.add('filled');

      if(count === messages.length){
        btn.textContent = 'Lire mon dernier mot ✦';
      }
    } else {
      showFinale();
    }
  });

  // ambient petals
  const petalChars = ['❀','✿','·','❃'];
  for(let i = 0; i < 14; i++){
    const p = document.createElement('div');
    p.className = 'petal';
    p.textContent = petalChars[Math.floor(Math.random()*petalChars.length)];
    p.style.left = Math.random() * 100 + 'vw';
    p.style.animationDuration = (9 + Math.random() * 10) + 's';
    p.style.animationDelay = (Math.random() * 10) + 's';
    p.style.fontSize = (0.8 + Math.random() * 0.9) + 'rem';
    document.body.appendChild(p);
  }
</script>

